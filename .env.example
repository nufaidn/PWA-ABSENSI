# ---------------------------------------------------------------------------
# Firebase / Firestore
# ---------------------------------------------------------------------------
# Server-side service account. Create one in Firebase Console → Project
# settings → Service accounts → Generate new private key. These values are
# secrets: never prefix them with NEXT_PUBLIC_ and never commit them.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Keep the newlines escaped as \n when the value is stored on one line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative: paste the whole service-account JSON (or its base64) as one
# variable. Useful on Vercel, where multi-line values are awkward. If set, it
# takes precedence over FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Used only by `npm run test:integration`. The Firebase emulator accepts
# unauthenticated clients, so no service account is needed for tests.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ byte random secret used to sign session JWTs (HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-base64-string"

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE="604800"

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Plain password assigned to every demo account created by `npm run db:seed`.
#
# The seed refuses to run when NODE_ENV=production unless SEED_ALLOW_DEMO_DATA is
# explicitly "true", because every seeded account shares this one password —
# including two admins. To create the first real account on an empty deployment
# use `npm run bootstrap:admin` instead; it generates a strong password.
SEED_DEFAULT_PASSWORD="Password123!"

# Must stay unset in production.
# SEED_ALLOW_DEMO_DATA="true"

# Used by `npm run bootstrap:admin`.
# BOOTSTRAP_ADMIN_EMAIL="admin@company.com"
# BOOTSTRAP_ADMIN_PASSWORD="<generated if omitted>"
# BOOTSTRAP_ORG_NAME="PT Contoh"

# ---------------------------------------------------------------------------
# One-off PostgreSQL → Firestore migration
# ---------------------------------------------------------------------------
# Only needed while running `npm run db:migrate-from-postgres`. Remove after the
# migration is verified; the application runtime never reads it.
# DATABASE_URL="postgresql://..."
# DATABASE_SSL="require"
