rules_version = '2';

// The browser never talks to Firestore. Every read and write goes through the
// Next.js server using the Admin SDK, which bypasses these rules. Denying all
// client access means a leaked Firebase config still cannot read attendance.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
