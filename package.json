{
  "name": "universal-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Attendance System — aplikasi absensi karyawan responsif (PWA) berbasis Next.js, Prisma, dan PostgreSQL.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "npm run test && npm run test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:purge-demo": "tsx scripts/delete-demo-accounts.ts --apply",
    "db:purge-reference": "tsx scripts/purge-reference-data.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "icons": "node scripts/generate-icons.mjs",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:check": "tsx scripts/check-database.ts",
    "db:audit": "tsx scripts/audit-workdate.ts",
    "db:clean": "tsx scripts/clean-dev-data.ts",
    "db:reset-data": "tsx scripts/reset-dev-data.ts",
    "e2e": "tsx scripts/check-e2e.ts",
    "repair:mojibake": "node scripts/repair-mojibake.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4"
  }
}
